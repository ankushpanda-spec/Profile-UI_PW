{
  "name": "mf-boilerplate-react",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "build": "rsbuild build --env-mode production && pnpm sentry:sourcemaps",
    "build:staging": "rsbuild build --env-mode staging && pnpm sentry:sourcemaps",
    "build:development": "rsbuild build --env-mode development && pnpm sentry:sourcemaps",
    "build:demo": "rsbuild build --env-mode demo && pnpm sentry:sourcemaps",
    "build:production": "rsbuild build --env-mode production && pnpm sentry:sourcemaps",
    "dev": "rsbuild dev --open --env-mode system",
    "dev:staging": "rsbuild dev --open --env-mode staging",
    "dev:demo": "rsbuild dev --open --env-mode demo",
    "dev:prod": "rsbuild dev --open --env-mode production",
    "preview": "rsbuild preview",
    "lint:debug": "eslint --debug ./src",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "prepare": "husky",
    "format": "prettier --write .",
    "commit-guide": "bash commitGuide.sh",
    "sentry:sourcemaps": "sentry-cli sourcemaps inject --org physicswallah --project pw-mf-common-fe-react ./dist && sentry-cli sourcemaps upload --org physicswallah --project pw-mf-common-fe-react ./dist"
  },
  "dependencies": {
    "@pw-tech/omni-context": "0.0.6-alpha-1.4",
    "@pw-tech/omni-ui": "0.0.29",
    "@pw-tech/web-sdk": "0.0.8-7-alpha",
    "@radix-ui/react-popover": "^1.1.1",
    "@sentry/cli": "^2.41.1",
    "@sentry/react": "^8.54.0",
    "@sentry/webpack-plugin": "^3.1.2",
    "clsx": "^2.1.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hook-form": "^7.56.2",
    "react-router-dom": "^6.26.2",
    "tailwind-merge": "^2.5.2",
    "tailwind-scrollbar": "^3.1.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.5.0",
    "@commitlint/config-conventional": "^19.5.0",
    "@eslint/compat": "^1.2.3",
    "@eslint/js": "^9.15.0",
    "@module-federation/rsbuild-plugin": "0.7.0",
    "@rsbuild/core": "1.1.0",
    "@rsbuild/plugin-react": "1.0.6",
    "@types/node": "^22.7.3",
    "@types/react": "^18.3.9",
    "@types/react-dom": "^18.3.0",
    "@typescript-eslint/eslint-plugin": "^8.23.0",
    "@typescript-eslint/parser": "^8.23.0",
    "eslint": "^9.19.0",
    "eslint-config-airbnb": "^19.0.4",
    "eslint-config-prettier": "^10.0.1",
    "eslint-import-resolver-typescript": "^3.7.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "eslint-plugin-filenames": "^1.3.2",
    "eslint-plugin-import": "^2.31.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.2.3",
    "eslint-plugin-react": "^7.37.4",
    "eslint-plugin-react-hooks": "^5.1.0",
    "eslint-plugin-simple-import-sort": "^12.1.1",
    "eslint-plugin-tailwindcss": "^3.18.0",
    "eslint-plugin-unicorn": "^56.0.1",
    "eslint-rspack-plugin": "^4.2.1",
    "globals": "^15.14.0",
    "husky": "^9.1.7",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.8",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.23.0"
  }
}

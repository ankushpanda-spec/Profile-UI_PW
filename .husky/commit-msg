# Run Commitlint
if ! npx --no-install commitlint --edit "$1"; then
  # Define styles for color and formatting
  border="═══════════════════════════════════════════════"
  red="\033[1;31m"
  green="\033[1;32m"
  yellow="\033[1;33m"
  cyan="\033[1;36m"
  reset="\033[0m"
  bold="\033[1m"

  # Define dark vibrant background colors
  bg_build="\033[48;5;34m"   # dark green
  bg_chore="\033[48;5;93m"   # dark yellow
  bg_ci="\033[48;5;27m"      # dark blue
  bg_docs="\033[48;5;22m"    # dark teal
  bg_feat="\033[48;5;33m"    # dark cyan
  bg_fix="\033[48;5;1m"      # dark red
  bg_perf="\033[48;5;226m"   # bright yellow
  bg_refactor="\033[48;5;235m" # gray
  bg_revert="\033[48;5;166m" # dark orange
  bg_style="\033[48;5;30m"    # dark cyan
  bg_test="\033[48;5;208m"    # orange
  bg_hotfix="\033[48;5;196m"  # bright red

  # Display error header
  echo -e "${cyan}${border}${reset}"
  echo -e "${red}${bold}🚨 ERROR: Commit message does not follow the required format.${reset}"
  echo -e "${cyan}${border}${reset}"

  # Format requirements
  echo -e "\n${yellow}${bold}FORMAT REQUIRED:${reset} ${bold}<type>(SCOPE-TICKET): <Description>${reset}"
  echo -e "${green}RULES:${reset}"
  echo -e "   • ${bold}Allowed types:${reset} ${bg_build}\033[37mbuild${reset}, ${bg_chore}\033[37mchore${reset}, ${bg_ci}\033[37mci${reset}, ${bg_docs}\033[37mdocs${reset}, ${bg_feat}\033[37mfeat${reset}, ${bg_fix}\033[37mfix${reset}, ${bg_perf}\033[37mperf${reset}, ${bg_refactor}\033[37mrefactor${reset}, ${bg_revert}\033[37mrevert${reset}, ${bg_style}\033[37mstyle${reset}, ${bg_test}\033[37mtest${reset}, ${bg_hotfix}\033[37mhotfix${reset}"
  echo -e "   • ${bold}Scope (SCOPE-TICKET):${reset} Must include uppercase letters and a ticket number (e.g., FEATURE-123)"
  echo -e "   • ${bold}Description:${reset} Must start with an uppercase letter and have a space after ':'"

  # Type Descriptions
  echo -e "\n${cyan}${border}${reset}"
  echo -e "${yellow}${bold}COMMIT TYPES AND THEIR DESCRIPTIONS:${reset}"
  echo -e "${cyan}${border}${reset}"
  echo -e "   ${bg_build}\033[37mbuild:${reset} Changes that affect the build system or external dependencies (e.g., updating npm packages)"
  echo -e "   ${bg_chore}\033[37mchore:${reset} Routine tasks or maintenance (e.g., updating license, reformatting code)"
  echo -e "   ${bg_ci}\033[37mci:${reset} Changes to CI configuration files and scripts (e.g., GitLab, GitHub Actions)"
  echo -e "   ${bg_docs}\033[37mdocs:${reset} Documentation changes only (e.g., updating README, adding comments)"
  echo -e "   ${bg_feat}\033[37mfeat:${reset} A new feature added to the codebase"
  echo -e "   ${bg_fix}\033[37mfix:${reset} A bug fix or issue resolution"
  echo -e "   ${bg_perf}\033[37mperf:${reset} Code changes that improve performance (e.g., optimizing loops)"
  echo -e "   ${bg_refactor}\033[37mrefactor:${reset} Code restructuring without changing behavior (e.g., renaming variables)"
  echo -e "   ${bg_revert}\033[37mrevert:${reset} Reverting a previous commit"
  echo -e "   ${bg_style}\033[37mstyle:${reset} Code style changes (e.g., formatting, adding/removing whitespace)"
  echo -e "   ${bg_test}\033[37mtest:${reset} Adding or modifying tests (e.g., unit tests, integration tests)"
  echo -e "   ${bg_hotfix}\033[37mhotfix:${reset} Critical fix that needs immediate attention"

  # Examples
  echo -e "\n${cyan}${border}${reset}"
  echo -e "${yellow}${bold}EXAMPLES OF VALID COMMIT MESSAGES:${reset}"
  echo -e "${cyan}${border}${reset}"
  echo -e "1. ${green}Standard Commit Types with Scope:${reset}"
  echo -e "   - ${bold}feat(FEATURE-123):${reset} Add new user login feature"
  echo -e "   - ${bold}fix(BUG-456):${reset} Correct header alignment issue"
  echo -e "   - ${bold}docs(DOCS-789):${reset} Update README with new instructions"
  echo -e "   - ${bold}chore(DEPS-1011):${reset} Upgrade dependencies to latest versions"
  echo -e "   - ${bold}refactor(CODE-202):${reset} Improve function naming for clarity"

  echo -e "\n2. ${green}Release Commit:${reset}"
  echo -e "   - ${bold}chore(release):${reset} Release version 1.2.0"

  echo -e "\n3. ${green}Merge Commits:${reset}"
  echo -e "   - ${bold}Merge branch 'feature/new-login' into 'main'${reset}"
  echo -e "   - ${bold}Merge pull request #123 from feature/new-setup${reset}"

  # Breakdown of message format
  echo -e "\n${cyan}${border}${reset}"
  echo -e "${yellow}${bold}BREAKDOWN OF MESSAGE FORMAT:${reset}"
  echo -e "${cyan}${border}${reset}"
  echo -e "• ${green}Standard Commits:${reset} ${bold}{type}({SCOPE}): {Message}${reset}"
  echo -e "   - ${bold}{type}:${reset} One of build, chore, ci, docs, feat, fix, perf, refactor, revert, style, test, hotfix"
  echo -e "   - ${bold}{SCOPE}:${reset} Uppercase with ticket number (e.g., FEATURE-123)"
  echo -e "   - ${bold}{Message}:${reset} Start with a capital letter"

  echo -e "\n• ${green}Release Commits:${reset} ${bold}chore(release): Release {details}${reset} (no scope required)"
  echo -e "\n• ${green}Merge Commits:${reset} Messages starting with 'Merge' are also accepted."

  # Final border and exit
  echo -e "${cyan}${border}${reset}"

  # Exit with status code 1 to prevent the commit
  exit 1
else
  # If commit is successful, display success message
  echo -e "${green}${bold}✅ Commit successful: Code committed successfully!${reset}"
  echo -e "${cyan}${border}${reset}"
fi

